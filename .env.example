DATABASE_URL=postgresql+psycopg://convictionos:convictionos@localhost:54329/convictionos
TEST_DATABASE_URL=postgresql+psycopg://convictionos:convictionos@localhost:54330/convictionos_test
BROKER_MODE=fake
# Readiness and dashboard disclosures remain paper-only; there is no live mode.
ALPACA_OAUTH_TOKEN=replace-with-rotated-paper-oauth-token-in-secret-manager
ALPACA_API_KEY_ID=replace-with-rotated-paper-key-id-in-secret-manager
ALPACA_API_SECRET_KEY=replace-with-rotated-paper-secret-in-secret-manager
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# indicative works without OPRA and is valid for the hackathon paper account flow.
# OPRA can improve performance analysis but is not required for paper execution.
ALPACA_OPTION_DATA_FEED=indicative
COMPETITION_ACCOUNT_ID=replace-with-private-competition-paper-account-id-in-secret-manager
COMPETITION_BASELINE_EQUITY=100000.00
COMPETITION_MANDATE_VERSION=competition-defined-risk-v1
ALPACA_LIVE_TRADE=false
ALPACA_CLI_REVISION=
ALPACA_CLI_PATH=
ALPACA_MCP_VERSION=
ALPACA_MCP_COMMAND=
ALPACA_MCP_SCHEMA_HASH=
AGENT_ENABLED=false
AGENT_CONTROL_TOKEN=replace-with-random-control-token-in-secret-manager
AGENT_UNDERLYING=SPY
AGENT_INTERVAL_SECONDS=300
EXIT_POLICY_VERSION=exit-policy-v1
# Catalyst, swing, and thematic DTE bands are enforced by the router/risk layer.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/auto
AI_API_KEY=replace-with-rotated-ai-key-in-secret-manager
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1200
AI_PROMPT_VERSION=grounded-thesis-v1
